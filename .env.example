DATABASE_URL=postgresql+asyncpg://numsa:numsa_pass@postgres:5432/numsa_db
REDIS_URL=redis://redis:6379
# Generar con: openssl rand -hex 32 — nunca usar este valor en producción
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
# Orígenes permitidos por CORS, separados por coma (sin espacios finales)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_USER=numsa
POSTGRES_PASSWORD=numsa_pass
POSTGRES_DB=numsa_db

# URL pública del backend tal como la va a ver el navegador (IP o dominio del server)
NEXT_PUBLIC_API_URL=http://localhost:8000
